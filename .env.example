# ---------------------------------------------------------------------------
# Connexion Jira (lecture seule) — ces variables restent côté serveur.
# Ne JAMAIS préfixer par NEXT_PUBLIC_ : elles seraient exposées au navigateur.
# Copier ce fichier en .env.local puis renseigner les valeurs.
# ---------------------------------------------------------------------------

# URL de base de l'instance Jira, sans slash final.
#   Jira Cloud          : https://votre-societe.atlassian.net
#   Jira Data Center    : https://jira.example.com
JIRA_BASE_URL=

# Jira Cloud : adresse e-mail du compte + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Jira Data Center : laisser JIRA_EMAIL vide et mettre un Personal Access Token dans JIRA_API_TOKEN
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Optionnel -------------------------------------------------------------
# Type d'instance : cloud | datacenter. Par défaut : "cloud" si l'URL se termine par atlassian.net.
# JIRA_DEPLOYMENT=
# Authentification : basic (e-mail + token) | bearer (PAT Data Center). Par défaut : basic si JIRA_EMAIL est renseigné.
# JIRA_AUTH_TYPE=
# Timeout d'un appel Jira en millisecondes (défaut : 20000).
# JIRA_TIMEOUT_MS=
# Durée du cache serveur en secondes (défaut : valeur de config/pilotage.ts).
# PILOTAGE_CACHE_TTL_SECONDS=
# Forcer les données de démonstration même si Jira est configuré : true | false.
# PILOTAGE_DEMO_MODE=
